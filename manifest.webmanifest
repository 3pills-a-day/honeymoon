{
 "name": "신혼여행 지도",
 "short_name": "신혼여행",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#ffffff",
 "theme_color": "#161616",
 "icons": [
  {
   "src": "icons/icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icons/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "files",
     "accept": [
      "image/*",
      "application/pdf"
     ]
    }
   ]
  }
 }
}